root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Java: 네이버 핵데이 컨벤션 (탭, 크기 4, 120자)
[*.java]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 120

[*.{gradle,kts,sql}]
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Frontend
[*.{js,jsx,ts,tsx,json,css,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
