# 운영 .env 예시. 각 서버의 /opt/rental/.env 로 복사해 값을 채우고 chmod 600. 이 예시 외의 .env는 절대 커밋하지 않는다.
# 비밀값 칸은 비워 두었다. 포트·지역처럼 비밀이 아닌 값만 기본값을 적었다.
# 주석은 줄 맨 앞에만 쓴다(값 뒤에 붙이면 값으로 읽힌다). 값에 공백·따옴표를 넣지 않는다.
# 이 파일은 compose 변수 치환(--env-file)과 백엔드 컨테이너 환경 변수(env_file) 양쪽에 쓰인다.
# 두 서버의 내용은 같고 TRUSTED_PROXY_REGEX만 2번 서버에서 쓴다(1번은 compose가 Nginx 고정 주소로 덮어쓴다).
# REDIS_HOST·RABBITMQ_HOST는 서버마다 compose가 정하므로 여기에 두지 않는다.

# 이미지 (CI가 GHCR에 push. 롤백은 deploy.sh의 태그 인자로)
IMAGE_REGISTRY=ghcr.io/seungmin222

# 서버 사설 IP (EC2 콘솔의 프라이빗 IPv4)
SERVER1_PRIVATE_IP=
SERVER2_PRIVATE_IP=

# 2번 서버 앱이 신뢰할 프록시 = 1번 서버 사설 IP를 점 이스케이프한 정규식. 예: 10.0.1.23 → 10[.]0[.]1[.]23
TRUSTED_PROXY_REGEX=

# CloudFront 사용자 지정 오리진 헤더 X-Origin-Verify 값과 같게. 영문·숫자 32자 이상 (openssl rand -hex 32)
ORIGIN_VERIFY_SECRET=

# 백엔드 힙 상한 (compose mem_limit 1200m 안에서)
JAVA_MAX_HEAP=768m

# DB (RDS for MySQL 엔드포인트)
DB_HOST=
DB_PORT=3306
DB_NAME=rental
DB_USERNAME=
DB_PASSWORD=
# (선택) RDS가 기본 파라미터 그룹(time_zone=UTC)일 때 세션 시간대까지 서울로 맞추려면 주석을 풀고 값을 채운다.
# application-prod.yml의 URL을 덮어쓴다. ${DB_HOST} 대신 실제 엔드포인트를 적는다(infra/README.md 2절 "RDS 파라미터 그룹").
# 예: jdbc:mysql://<RDS 엔드포인트>:3306/rental?characterEncoding=UTF-8&connectionTimeZone=Asia/Seoul&forceConnectionTimeZoneToSession=true
# SPRING_DATASOURCE_URL=

# Redis (1번 서버 컨테이너, requirepass)
REDIS_PASSWORD=

# RabbitMQ (2번 서버 컨테이너. guest 금지)
RABBITMQ_PORT=5672
RABBITMQ_STOMP_PORT=61613
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# JWT (256bit 이상 랜덤. openssl rand -base64 48)
JWT_SECRET=

# 파일 저장소 S3. 자격 증명은 운영진 제공 인스턴스 프로필 SafeInstanceProfile-inha-capstone-19(SDK 기본 체인)이라 액세스 키를 두지 않는다
AWS_REGION=ap-northeast-2
# 버킷 이름은 inha-capstone-19 로 시작해야 한다. 예: inha-capstone-19-rental-files
AWS_S3_BUCKET=
# CloudFront 주소 + /files (끝에 / 없이). 예: https://dxxxxxxxx.cloudfront.net/files
AWS_S3_PUBLIC_URL=

# 프론트 주소 = CloudFront 주소 (비밀번호 재설정 메일 링크). 예: https://dxxxxxxxx.cloudfront.net
FRONTEND_BASE_URL=

# 메일 (SMTP, STARTTLS). 비워 두면 기동은 되고 비밀번호 재설정 메일 발송만 실패한다
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# 외부 API
TOSS_SECRET_KEY=
KAKAO_REST_API_KEY=
ANTHROPIC_API_KEY=

# 기능 플래그 (docs/architecture.md §9. 프론트 VITE_PAYMENT_ENABLED와 같게)
APP_FEATURE_PAYMENT_ENABLED=false
