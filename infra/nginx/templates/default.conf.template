# 운영 Nginx (1번 서버). 공식 nginx 이미지가 기동 시 envsubst로 ${SERVER2_PRIVATE_IP}·${ORIGIN_VERIFY_SECRET}만 치환해
# /etc/nginx/conf.d/default.conf로 만든다(정의된 환경 변수만 치환하므로 $host 같은 Nginx 변수는 그대로 남는다).
# 앞단은 CloudFront 하나다: 브라우저 → CloudFront(HTTPS) → 이 Nginx(80, HTTP) → Spring Boot 2대. 계약은 infra/nginx/README.md

# 비밀값(64자 등)이 아래 map 키가 되므로 버킷을 늘린다(첫 map보다 앞에 둬야 한다). 05-require-env.sh가 길이를 32~100자로 제한
map_hash_bucket_size 128;

# 실제 클라이언트 IP (REQ-011 비회원 조회수). CloudFront 오리진 요청 정책이 넘기는 CloudFront-Viewer-Address("IP:포트",
# IPv6도 콜론 구분 그대로)에서 마지막 ":포트"를 뗀다. 헤더가 없으면 TCP 접속 주소. 클라이언트가 보낸 X-Forwarded-For는 쓰지 않는다
map $http_cloudfront_viewer_address $client_ip {
    "~^(?<viewer_ip>.+):[0-9]+$" $viewer_ip;
    default $remote_addr;
}

# CloudFront 뷰어 프로토콜 정책이 HTTPS 리디렉션이라 브라우저 쪽은 항상 https
map $http_cloudfront_forwarded_proto $forwarded_proto {
    "http" http;
    default https;
}

# CloudFront 사용자 지정 오리진 헤더 X-Origin-Verify. 80은 CloudFront 관리형 접두사 목록에만 열리지만
# 그 목록은 다른 사람의 CloudFront 배포도 통과시키므로, 우리 배포에서 온 요청만 받는다
map $http_x_origin_verify $origin_verified {
    "${ORIGIN_VERIFY_SECRET}" 1;
    default 0;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

upstream rental_backend {
    # 1번 서버 앱(같은 compose 네트워크) + 2번 서버 앱(사설 IP). 한쪽이 연결 실패하면 멱등 요청만 다른 쪽으로 다시 보낸다(기본값)
    server backend:8080 max_fails=3 fail_timeout=10s;
    server ${SERVER2_PRIVATE_IP}:8080 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

log_format rental '$client_ip - [$time_local] "$request" $status $body_bytes_sent $request_time '
    'up=$upstream_addr ut=$upstream_response_time';

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/access.log rental;

    # docs/policies.md upload.max-request-size (110MB). 백엔드 multipart 한도와 같게
    client_max_body_size 110m;

    if ($origin_verified = 0) {
        return 403;
    }

    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass http://rental_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # 헤더 계약(README.md): 클라이언트가 보낸 값을 이어 붙이지 않고 덮어쓴다
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Forwarded "";
        proxy_set_header X-Origin-Verify "";
        # CloudFront 오리진 응답 제한 시간(60s)과 같게. 업로드는 버퍼링 후 전달
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # STOMP over WebSocket. 연결은 붙은 인스턴스에 머물고 다른 인스턴스와는 RabbitMQ 릴레이로 공유하므로 고정 세션이 필요 없다
    location /ws {
        proxy_pass http://rental_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Forwarded "";
        proxy_set_header X-Origin-Verify "";
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Vite 빌드 산출물(파일명에 해시). 오래 캐시
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback. index.html은 배포 직후 새 해시 파일을 가리키도록 매번 확인
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
