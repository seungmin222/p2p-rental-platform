# 복사해서 infra/.env 로 사용. .env 는 절대 커밋하지 않는다.

# DB
DB_NAME=rental
DB_USERNAME=rental
DB_PASSWORD=rental
DB_ROOT_PASSWORD=root

# Redis / RabbitMQ
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# JWT (256bit 이상 랜덤 문자열)
JWT_SECRET=change-me

# AWS S3
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 외부 API
TOSS_SECRET_KEY=          # 토스페이먼츠 테스트 시크릿 키
KAKAO_REST_API_KEY=       # 카카오 로컬 API (좌표→행정동)
ANTHROPIC_API_KEY=        # Claude API (REQ-040)

# 메일 (비밀번호 재설정)
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=

# 기능 플래그
APP_FEATURE_PAYMENT_ENABLED=false
