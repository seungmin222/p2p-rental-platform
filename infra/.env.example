# 복사해서 infra/.env 로 사용. .env 는 절대 커밋하지 않는다.
# 주석은 반드시 줄 맨 앞에만 쓴다(값 뒤에 붙이면 Spring이 주석까지 값으로 읽는다).
# docker compose(--env-file)와 백엔드 local 프로필(spring.config.import)이 같이 읽는다.

# DB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rental
DB_USERNAME=rental
DB_PASSWORD=rental
DB_ROOT_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ (AMQP: AI 작업 큐 / STOMP: 채팅·알림 브로커 릴레이)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_STOMP_PORT=61613
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# JWT (256bit 이상 랜덤 문자열. 로컬은 아무 긴 문자열)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# 파일 저장소: 프로필로 정해진다. local·test = 디스크(backend/uploads), prod = S3
# 아래는 prod(S3)에서만 필요. 로컬은 비워 둔다. AWS_S3_PUBLIC_URL은 CDN을 쓸 때만(기본: 버킷 주소)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 메일 (로컬은 Mailpit, 인증 없음)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# 외부 API
# 토스페이먼츠 테스트 시크릿 키 (API 개별 연동)
TOSS_SECRET_KEY=
# 토스페이먼츠 테스트 클라이언트 키 (API 개별 연동). Vite는 이 파일을 읽지 않으므로 frontend/.env.local에도 같은 값을 넣는다
VITE_TOSS_CLIENT_KEY=
# 카카오 로컬 API (좌표→행정동)
KAKAO_REST_API_KEY=
# Claude API (REQ-040). 비우면 AI 비교 없이 진행
ANTHROPIC_API_KEY=

# 기능 플래그
APP_FEATURE_PAYMENT_ENABLED=false
