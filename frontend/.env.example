# 복사해서 frontend/.env.local 로 사용. .env.local 은 커밋하지 않는다.

# API 기준 경로. 로컬은 Vite 프록시를 타도록 상대 경로 그대로 둔다.
VITE_API_URL=/api
VITE_WS_URL=/ws

# 백엔드 없이 MSW 목 데이터로 개발할 때 true
VITE_USE_MOCK=true

# 1순위 단계: false (예약 후 결제 없이 바로 대여 상세로)
VITE_PAYMENT_ENABLED=false

# 카카오맵 JavaScript 키 (카카오 개발자 콘솔에 http://localhost:5173 등록)
VITE_KAKAO_MAP_KEY=

# 토스페이먼츠 테스트 클라이언트 키 (API 개별 연동 키, 결제위젯 키 아님)
VITE_TOSS_CLIENT_KEY=
